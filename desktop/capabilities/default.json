{
  "identifier": "default",
  "description": "Main window — core webview/event/window without unused tray/menu/image defaults.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:app:default",
    "core:resources:default",
    "allow-Oryn-commands",
    "updater:default",
    "process:allow-restart"
  ]
}
